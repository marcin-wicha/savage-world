# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in your global git ignore instead.

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Environment files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Backend: bundler
backend/.bundle

# Backend: logs and temp files
backend/log/*
!backend/log/.keep
backend/tmp/*
!backend/tmp/.keep
backend/tmp/pids/*
!backend/tmp/pids/
!backend/tmp/pids/.keep
backend/tmp/storage/*
!backend/tmp/storage/
!backend/tmp/storage/.keep

# Backend: uploaded files and databases
backend/storage/*
!backend/storage/.keep

# Backend: private, licensed game data
backend/db/data/edges/private/
backend/db/data/hindrances/private/
backend/db/data/skills/private/

# Backend: compiled assets
backend/public/assets

# Backend: credentials
backend/config/*.key
backend/config/credentials/*.key

# Frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/.eslintcache

# Frontend: private, licensed card artwork
frontend/public/traits/
