#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

run_pnpm() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- pnpm "$@"
  else
    pnpm "$@"
  fi
}

trap 'kill 0' EXIT INT TERM

"$ROOT/backend/bin/rails" server -p 3000 &

if [ -f "$ROOT/frontend/package.json" ]; then
  run_pnpm --dir "$ROOT/frontend" dev &
fi

wait -n
