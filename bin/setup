#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

run_pnpm() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- pnpm "$@"
  else
    pnpm "$@"
  fi
}

"$ROOT/backend/bin/setup" --skip-server

if [ -f "$ROOT/frontend/package.json" ]; then
  run_pnpm --dir "$ROOT/frontend" install
fi
